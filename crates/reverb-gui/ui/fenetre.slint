// La fenêtre Reverb.
//
// Le boîtier vu depuis le panneau latéral gauche, face à la carte mère :
// l'arrière à gauche, l'avant à droite. Les places viennent de `plan.rs`, les
// couleurs du démon — ce sont les images qu'il envoie vraiment au matériel.
//
// ── La disposition, et pourquoi elle a changé (#76) ────────────────────────
//
// Elle tenait en deux colonnes : la maquette, et **une seule** colonne de
// 340 px où six panneaux s'empilaient dans un `ScrollView`. Mesuré à 1180×760,
// leur hauteur cumulée dépassait 1400 px pour 690 px visibles : ÉCRAN et
// VENTILATEURS étaient entièrement sous le pli, et rien ne le disait. #74, #75
// et #80 ajoutaient six cents pixels de plus à cette même colonne.
//
// D'où trois colonnes, et un principe : **ce qu'on vise à gauche, l'objet au
// centre, ce qu'on lui fait à droite.** Les trois sujets qui ne sont pas
// l'éclairage — l'écran, les ventilateurs — passent en onglets plutôt qu'en
// suite, parce qu'on ne les règle pas en même temps que la couleur.

import { Button, Slider, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct PointLed {
    x: float,
    y: float,
    rayon: float,
    // Hauteur ajoutee au disque, en fraction du cadre. Zero pour une LED ; une
    // reglette de RAM vue au detail « ventilateur » est une gelule, pas un rond.
    hauteur: float,
    couleur: color,
    choisie: bool,
}

// Une couche du halo d'une LED (#64). C'est ce qui fait qu'un boitier RGB
// ressemble a un boitier RGB : sur les photos, la couleur d'un ventilateur
// deborde largement sur les parois autour de lui.
//
// ⚠️ Ce sont des disques DESSINES, pas une ombre portee : le rendu logiciel de
// Slint — celui de `examples/apercu.rs` — ignore `drop-shadow-blur`, mesure.
//
// Rayon et opacite viennent de `plan.rs` : le .slint ne decide de rien, il
// dessine ce qu'on lui donne. L'opacite est deja dans l'alpha de la couleur.
export struct PointHalo {
    x: float,
    y: float,
    rayon: float,
    couleur: color,
}

export struct LigneVentilateur {
    canal: string,
    position: string,
    rpm: string,
    pwm: int,
    // La consigne ecrite, telle que `consigne_affichee` la rend (#102). Une
    // chaine et non un `pwm` formate ici : la regle qui compte — « le nombre
    // vient de la poignee, et de nulle part ailleurs » — se tient alors par un
    // test qui tourne a chaque `cargo test`, et non par une relecture d'apercu.
    consigne: string,
    mode: string,
    lisible: bool,
    // Ce canal sait-il rendre la main a une regulation automatique. Faux pour
    // les trois canaux de nzxtsmart2, dont le pilote n'a aucun mode
    // automatique : on ne montre pas un bouton qui ne peut qu'echouer (#50).
    sait-faire-auto: bool,
    // Ce canal regule-t-il seul — « non-pilote » ou « courbe-de-l'hote » ?
    // Alors quelque chose d'AUTRE que l'hote decide de sa vitesse, et une
    // consigne ecrite la remplace sans retour possible : aucune valeur de
    // pwmN_enable ne rend le Kraken a son profil d'usine, seule une coupure
    // d'alimentation complete le fait (#112).
    //
    // ⚠️ C'est un fait LU sur le materiel, jamais une liste de noms de
    // controleurs : un canal du Kraken deja passe en manuel n'a plus rien a
    // proteger, et lui laisser un cadenas serait mentir.
    regule-seul: bool,
    // Le cadenas a-t-il ete ouvert a la main. Memoire de FENETRE : il repart
    // ferme a chaque ouverture, un verrou qui se souviendrait d'avoir ete
    // ouvert ne protegerait plus rien le lendemain.
    deverrouille: bool,
    // Le pilote de ce canal n'a AUCUN mode automatique, donc c'est a l'hote de
    // le reguler s'il doit l'etre (#113). Vrai pour les trois canaux
    // nzxtsmart2, faux pour les deux du Kraken — leur firmware regule deja, et
    // #99 les met hors scope.
    regulable: bool,
    // Le demon regule ce canal, a ce tour-ci. Vient des lignes « regule » du
    // meme tour, JAMAIS d'une memoire de fenetre : un « regule off » pose par
    // le socket depuis un autre client doit se voir ici a la seconde suivante.
    //
    // ⚠️ Ce n'est PAS `regule-seul`, qui dit le contraire — le peripherique se
    // regule tout seul (#112). Les deux grisent une barre pour des raisons
    // OPPOSEES : ici on protege la boucle du demon, la on protege une
    // regulation d'usine qu'aucune commande ne retablit. L'interface les
    // distingue donc de trois facons — un temoin bleu qui ne parait que sur un
    // canal regule, un bouton qui dit « Ne plus reguler » la ou l'autre dit
    // « Deverrouiller », et la colonne MODE qui n'ecrit « non-pilote » que pour
    // le second. Sans quoi « pourquoi je ne peux pas bouger cette barre »
    // n'aurait pas de reponse lisible.
    sous-regulation: bool,
}

// Un palier de la courbe de regulation, tel que l'editeur le montre (#113).
//
// Deux graphies pour la meme chose, et c'est voulu : `temperature` et
// `consigne` sont ce qui se LIT — « 45,5 °C », « 60 % » —, `degres` et
// `pourcent` ce que les deux poignees portent.
//
// ⚠️ L'unite du protocole reste le MILLIDEGRE entier (#99). Les poignees ne
// graduent qu'en degres ; un demi-degre rendu par le socket survit donc tant
// que personne ne touche a SON palier, et repart intact.
export struct PalierCourbe {
    temperature: string,
    consigne: string,
    degres: int,
    pourcent: int,
}

// Un mode de la colonne MODE, et ce qu'il veut dire (#112).
//
// Le texte vient de `telemetrie::aide_des_modes()` — six libelles dont trois
// demandent un contexte que seul `docs/VENTILATEURS.md` porte. Chacun dit QUI
// decide de la vitesse et CE QU'ON PERD en y touchant : c'est l'information qui
// manquait le 2026-08-15, quand un clic sur « auto » a mis la consigne de la
// pompe a 0 %.
export struct AideMode {
    mode: string,
    texte: string,
}

export struct LigneTemperature {
    // Le nom lisible de la sonde — « CPU », « Liquide », « NVMe … ». Jamais un
    // nom de hwmon : le panneau se lit, il ne se decode pas (issue #51).
    libelle: string,
    valeur: string,
    // La courbe des deux dernieres minutes, en commandes SVG dans le carre
    // unite. Vide tant qu'il n'y a qu'un seul releve : un point n'est pas une
    // courbe.
    courbe: string,
    lisible: bool,
}

export struct LigneZone {
    nom: string,
    // Ce qu'elle affiche, en clair : « transparente », « #ff0000 », « braise ».
    rendu: string,
    // Combien de LED elle tient.
    combien: int,
    visee: bool,
}

export struct FamilleAnimation {
    nom: string,
    effet: string,
    accepte-couleur: bool,
    // Cette famille se projette-t-elle sur un axe du boitier ? Faux pour
    // `rotation`, `pouls` et `scintillement`, dont le motif ne suit aucun axe,
    // et pour `thermique`, dont la sonde remplace la direction. Montrer un
    // menu de directions a cote d'elles ferait REFUSER la commande entiere —
    // une cle de trop, et c'est tout l'`animate` qui tombe.
    suit-une-direction: bool,
    // `thermique` EXIGE une sonde, seule du catalogue : `Reglages::default()`
    // n'a aucune valeur sensee a lui donner, la machine en expose seize.
    exige-une-sonde: bool,
}

// Une ambiance enregistree (#74).
export struct LigneProfil {
    nom: string,
    // Vrai pour celui que la fenetre vient de rappeler.
    //
    // ⚠️ « Rappele », et non « actif ». Le protocole ne dit PAS quel profil est
    // actif : `ResponseLine::Profil` ne survit pas a la reponse qui la porte, et
    // rien dans `status` n'en garde trace. C'est donc une memoire de fenetre,
    // effacee des qu'une commande change l'eclairage — dire « actif » d'un
    // profil dont on vient de changer la couleur serait faux.
    rappele: bool,
}

// Une des cinq ancres de composition (#80), placee dans le carre unite.
//
// Les places viennent de `Ancre::boite()` — les boites du DEMON, celles qu'il
// assombrit et sur lesquelles il ecrit. Ce n'est donc pas une reimplementation
// qui divergerait : c'est la meme donnee, lue une seule fois.
export struct AncreEcran {
    // Le mot qui part au demon : « haut », « bas », « gauche »…
    nom: string,
    // Ce que l'ancre porte, ou vide si elle est libre.
    porte: string,
    x: float,
    y: float,
    largeur: float,
    hauteur: float,
    occupee: bool,
    choisie: bool,
}

// Un curseur peint par ce qu'il parcourt.
//
// `std-widgets` n'expose pas la voie : impossible d'y mettre l'arc-en-ciel
// entier, ni le degrade du gris a la couleur. Vingt lignes ici valent mieux que
// de laisser trois curseurs identiques dire trois choses differentes.
component Curseur inherits Rectangle {
    in property <float> valeur;
    in property <float> maximum: 100;
    in property <brush> voie;
    callback change(float);

    height: 20px;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 10px;
        border-radius: 5px;
        background: root.voie;
        border-width: 1px;
        border-color: #00000040;
    }

    poignee := Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        border-width: 2px;
        border-color: #00000060;
        x: (root.valeur / root.maximum) * (parent.width - self.width);
        y: (parent.height - self.height) / 2;
    }

    zone := TouchArea {
        // La poignee est centree sur le point vise : la course utile est donc
        // amputee de sa largeur, une demie a chaque bout.
        function lue() -> float {
            return Math.clamp(
                (self.mouse-x - poignee.width / 2) / (self.width - poignee.width),
                0, 1
            ) * root.maximum;
        }
        pointer-event(evenement) => {
            if (evenement.kind == PointerEventKind.down) { root.change(zone.lue()); }
        }
        moved => { if (self.pressed) { root.change(zone.lue()); } }
    }
}

component Titre inherits Text {
    font-size: 12px;
    font-weight: 700;
    color: #6f7180;
    letter-spacing: 0.8px;
    // ⚠️ Un titre qui porte un slug de sonde — « ECRAN — gauge:kraken2023elite:
    // coolant-temp » — fait cinquante caracteres. Sans repli, sa largeur
    // PREFEREE devient la largeur MINIMALE du panneau, et le ScrollView sort
    // une barre horizontale.
    wrap: word-wrap;
}

component Carte inherits Rectangle {
    background: #191920;
    border-radius: 10px;
    border-width: 1px;
    border-color: #24242e;
}

// Une pastille qu'on choisit dans un groupe : famille d'animation, onglet,
// affichage d'ecran. Un `ComboBox` cache ce qui existe derriere un clic — dix
// familles y sont dix lignes qu'on ne voit qu'en le deroulant.
component Pastille inherits Rectangle {
    in property <string> texte;
    in property <bool> retenue;
    in property <bool> discrete;
    callback choisie();

    height: 26px;
    border-radius: 6px;
    background: root.retenue ? #2a3352 : (root.discrete ? #14141b : #1f1f28);
    border-width: 1px;
    border-color: root.retenue ? #4d7cff : #2a2a36;

    Text {
        text: root.texte;
        font-size: 11px;
        color: root.retenue ? #cdd8ff : #b9bbc9;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width - 8px;
        x: 4px;
        overflow: elide;
    }
    TouchArea { clicked => { root.choisie(); } }
}

export component Fenetre inherits Window {
    title: "Reverb";
    // Trois colonnes demandent de la largeur : 250 pour ce qu'on vise, 350 pour
    // ce qu'on regle, le reste au boitier. Sous 1080, la maquette deviendrait
    // plus petite que les panneaux qui l'entourent.
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 1080px;
    min-height: 680px;
    background: #0e0e13;

    in property <[PointLed]> leds;
    // Les aretes du boitier, en commandes SVG dans le carre unite. Vide de face.
    in property <string> aretes;
    // L'habillage, en commandes SVG dans le carre unite (#52). Aucune de ces
    // formes ne porte de coordonnee ecrite ici : elles viennent toutes de
    // plan.rs, sinon la maquette divergerait de la geometrie a la premiere
    // correction.
    in property <string> silhouette;
    in property <string> faces;
    in property <string> organes;
    in property <string> anneaux;
    // Les cadres de ventilateur, corps de barrette et la dalle du Kraken (#64).
    in property <string> habillage;
    // Les couches de halo, de la plus large a la plus serree.
    in property <[PointHalo]> halos;
    in property <[LigneVentilateur]> ventilateurs;
    // Les paliers de la courbe de regulation, tels que l'editeur les tient
    // (#113). Vides tant que le demon n'a rien rendu : le panneau n'invente
    // aucune courbe, comme une sonde muette n'invente aucune temperature.
    in property <[PalierCourbe]> paliers;
    // Le trace de ces paliers, en commandes SVG sur `trace-aspect` x 1.
    //
    // ⚠️ Il vient de `trace_de_courbe`, donc de `Courbe::consigne` — LA fonction
    // que le demon execute. Une boucle ecrite ici dessinerait une courbe que le
    // boitier n'applique pas, et rien ne le dirait (#113).
    in property <string> trace-courbe;
    // Le rapport largeur/hauteur dans lequel le trace ci-dessus est emis.
    //
    // ⚠️ **Slint met un `Path` a l'echelle UNIFORMEMENT et ne rogne pas au
    // viewbox.** Un carre unite dans un cadre large et bas n'occupe donc que sa
    // hauteur en largeur — 24 % du cadre, mesure au pixel le 2026-08-15. Ce
    // rapport sert donc DEUX fois, au viewbox et a la hauteur du cadre, pour que
    // la mise a l'echelle uniforme tombe juste. Il vient de `TRACE_ASPECT`, et
    // jamais d'un chiffre ecrit ici : deux valeurs a tenir d'accord
    // divergeraient, et le trace redeviendrait faux sans un mot.
    in property <float> trace-aspect: 4.0;
    // Les deux bornes de la plage tracee, telles qu'elles s'ecrivent.
    in property <string> borne-froide;
    in property <string> borne-chaude;
    // Pourquoi la courbe en cours d'edition ne peut pas etre posee, s'il y a
    // une raison. Vide quand elle est valide.
    //
    // ⚠️ Le juge est `Courbe::depuis`, celui du demon, et le refus arrive donc
    // DEVANT la poignee qu'on vient de bouger plutot que dans un journal apres
    // le geste.
    in property <string> refus-courbe;
    // Les six modes et leur explication. La liste vient de la bibliotheque, pas
    // d'ici : elle est celle du protocole, et l'ecrire dans ce fichier la
    // mettrait hors de portee des tests.
    in property <[AideMode]> aides-des-modes;
    in property <[LigneTemperature]> temperatures;
    in property <[FamilleAnimation]> familles;
    // Ce que le menu deroulant propose : « aucune » d'abord, puis les dix
    // familles dans l'ordre de CATALOGUE. Le rang zero n'est pas un trou, c'est
    // un choix — celui d'arreter.
    in property <[string]> animations;
    // Ce que les pastilles AFFICHENT — « Comete », « Arc-en-ciel ». Le rappel,
    // lui, envoie le nom du protocole : deux vues d'une meme liste, jamais deux
    // listes, et le rang les relie.
    in property <[string]> animations-lisibles;
    in-out property <int> animation-choisie: 0;
    // Les huit directions, dans l'ordre de `Direction::ALL` — le rang EST le
    // contrat. Une liste ecrite ici serait restee a six quand #75 en a livre
    // deux de plus, sans qu'aucun message ne le dise.
    in property <[string]> directions;
    // Les sondes sous leur nom lisible — « CPU », « Liquide ». Le slug ne
    // remonte jamais jusqu'ici : c'est `main.rs` qui le retrouve par le rang.
    in property <[string]> sondes-lisibles;
    in-out property <int> sonde-choisie: 0;
    // L'ecran du Kraken : ce qu'il montre, et de quoi le changer.
    in property <[string]> affichages: ["rien", "cadran", "image", "gif", "composition"];
    in property <[string]> affichages-lisibles: ["Rien", "Cadran", "Image", "GIF", "Composition"];
    in-out property <int> affichage-choisi: 0;
    in-out property <string> argument-ecran;
    in-out property <int> luminosite-ecran: 100;
    in property <string> affichage-ecran: "rien";
    // La composition (#80) : les cinq ancres, et de quoi en garnir une.
    in property <[AncreEcran]> ancres;
    // Le rayon du disque visible, en fraction du cote du tampon. Il vient de
    // `screen::VISIBLE_DISC_RADIUS` : la dalle est RONDE, et 21 % de ce qu'on
    // transmet ne s'affiche nulle part. L'ecrire ici le figerait le jour ou la
    // mire de #77 mesurera le vrai bord.
    in property <float> rayon-disque: 0.5;
    in-out property <int> fond-choisi: 0;
    in-out property <string> chemin-fond;
    // Le nom de l'ancre que le panneau édite. Il double le liseré bleu du
    // disque : « poser » et « vider » agissent dessus, et se tromper d'ancre ne
    // produit aucun message — juste un champ au mauvais endroit.
    in property <string> ancre-visee: "haut";
    in-out property <int> source-choisie: 0;
    in-out property <string> libelle-champ;
    in property <int> champs-poses: 0;
    in property <int> champs-max: 4;
    in property <[LigneZone]> zones;
    in-out property <string> nouvelle-zone;
    in property <[LigneProfil]> profils;
    in-out property <string> nouveau-profil;
    in property <string> cible: "tout le boîtier";
    in property <string> titre-maquette: "LE BOÎTIER";
    in property <bool> detail-led: true;
    in property <bool> vue-face: true;
    // Vrai tant que Ctrl est enfonce : le rectangle ajoute au lieu de remplacer.
    in-out property <bool> ajout: false;
    in property <string> animation-courante: "aucune";
    in property <string> message;
    in property <bool> connecte;
    in-out property <string> couleur: "ff40ff";
    in property <color> apercu: #ff40ff;
    // Les trois axes du selecteur, et la teinte pure qui peint deux des voies.
    in property <float> teinte: 300;
    in property <float> saturation: 75;
    in property <float> luminosite: 100;
    in property <color> teinte-pure: #ff00ff;
    in property <color> teinte-grise: #808080;
    in-out property <int> vitesse: 3;
    in-out property <int> direction: 4;
    // Lequel des trois onglets du panneau de droite est ouvert.
    in-out property <int> onglet: 0;

    // Le trace en cours, en **fractions du panneau** — jamais en pixels, et
    // depuis #121 plus en fractions du carre.
    //
    // Il vit sur `root` et non dans la `TouchArea` pour une raison qui n'est pas
    // esthetique : #76 avait cru rendre le rectangle visible en montant son
    // opacite, et personne n'a pu constater qu'il restait large de zero. Pose
    // ici, `apercu` sait le dessiner sans souris ni session graphique.
    //
    // ⚠️ **Le repere est celui du panneau, celui ou le geste a lieu.** Le
    // rectangle se dessine donc sur toute la surface sensible, marges comprises ;
    // en fractions de carre, un geste parti d'une marge serait trace rogne a son
    // bord — exactement ce que #121 corrige, montre a l'envers.
    in-out property <bool> trace;
    in-out property <float> trace-x0;
    in-out property <float> trace-y0;
    in-out property <float> trace-x1;
    in-out property <float> trace-y1;

    // La taille du panneau de la maquette, en pixels logiques.
    //
    // Elle sort d'ici parce que la conversion panneau → carre vit dans
    // `plan::trace_dans_la_maquette`, et nulle part ailleurs : ce qui est du
    // calcul se teste, ce qui est du dessin se regarde. Le `.slint` transmet les
    // dimensions et les fractions du geste ; le Rust convertit et decide.
    out property <float> panneau-largeur: panneau.width / 1px;
    out property <float> panneau-hauteur: panneau.height / 1px;

    // Le geste sur la maquette : deux coins et « faut-il ajouter a la selection ».
    // Un clic est un rectangle de cote nul — c'est le meme geste, et les
    // distinguer dans le Slint dupliquerait la regle des deux cotes.
    //
    // Les deux coins sont en **fractions du panneau** (#121), a ramener dans le
    // repere du carre par `plan::trace_dans_la_maquette` avec `panneau-largeur`
    // et `panneau-hauteur`. Ils sortent de `0..1` des que le geste touche une
    // marge, et rien ici ne les ecrete.
    callback geste-maquette(float, float, float, float, bool);
    callback basculer-detail();
    callback basculer-vue();
    callback couleur-saisie(string);
    callback teinte-changee(float);
    callback saturation-changee(float);
    callback luminosite-changee(float);
    callback choisir-cible(string);
    callback creer-zone(string);
    callback viser-zone(string);
    callback supprimer-zone(string);
    callback appliquer-couleur();
    callback lancer-animation(string);
    // Un réglage a bougé pendant que l'animation tourne. Sans ce rappel, le
    // curseur de vitesse n'écrivait qu'une propriété et le démon gardait la
    // vitesse d'avant.
    callback regler-animation();
    callback arreter-animation();
    // Les profils (#74) : rappeler, enregistrer sous un nom, oublier.
    callback rappeler-profil(string);
    callback enregistrer-profil(string);
    callback oublier-profil(string);
    // L'ecran : la luminosite part a chaque cran, l'affichage sur un bouton.
    callback regler-luminosite-ecran(int);
    callback poser-ecran(string, string);
    // L'utilisateur compose un affichage : suspendre l'adoption du releve.
    callback saisir-ecran();
    // La composition (#80). Une commande par changement, jamais une ligne
    // unique qui porterait tout : un chemin et un libelle sur la meme ligne
    // seraient ambigus au premier espace.
    callback viser-ancre(string);
    callback poser-fond();
    callback poser-champ(string);
    callback vider-champ(string);
    callback arreter-composition();
    callback regler-ventilateur(string, int);
    // La poignée est lâchée : à partir de là, la mesure a le droit de la
    // reprendre — mais pas tout de suite.
    callback relacher-ventilateur(string);
    callback rendre-au-firmware(string);
    // Le geste explicite qui ouvre — ou referme — le cadenas d'un canal (#112).
    callback basculer-verrou(string);
    // Prendre ce canal en charge, ou le rendre (#113).
    //
    // ⚠️ La fenetre n'ecrit aucun fichier et n'ouvre aucun peripherique
    // (ADR-002) : ceci part sur le socket, en « regule <canal> on|off », et
    // l'etat affiche revient du demon au tour suivant.
    callback basculer-regulation(string);
    // Deplacer un palier : son rang, puis sa valeur.
    callback regler-palier-temperature(int, int);
    callback regler-palier-consigne(int, int);
    // Poser la courbe editee. Refusee EN LE DISANT si elle n'en est pas une.
    callback appliquer-courbe();

    // La famille retenue, ou une famille vide quand c'est « aucune ». Evite de
    // repeter le decalage de rang — le menu commence par « aucune », le
    // catalogue non — a chacun des quatre endroits qui l'interrogent.
    property <FamilleAnimation> famille-retenue:
        root.animation-choisie > 0 && root.familles.length > 0
            ? root.familles[Math.min(root.animation-choisie - 1, root.familles.length - 1)]
            : { nom: "", effet: "Aucune animation : le boîtier garde sa couleur.",
                accepte-couleur: false, suit-une-direction: false, exige-une-sonde: false };

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        // ── En-tête, et les profils ────────────────────────────────────────
        // Les profils y sont, et non dans un panneau : rappeler une ambiance
        // est le geste qui change le plus de choses d'un seul clic, et il ne
        // se merite pas au bout d'une colonne a derouler.
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Reverb";
                font-size: 22px;
                font-weight: 800;
                color: #4d7cff;
                vertical-alignment: center;
            }
            Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: root.connecte ? #35c46a : #d9534f;
                y: (parent.height - self.height) / 2;
            }
            // ⚠️ **Un message reel prend toujours le pas.** Le libelle de
            // connexion n'est qu'un repli : sans lui, le seul moyen d'apprendre
            // ce que signifie la pastille verte etait de la voir passer au
            // rouge — un indicateur qui n'enseigne son sens qu'au pire moment.
            Text {
                text: root.message != ""
                    ? root.message
                    : (root.connecte ? "Démon connecté" : "Démon injoignable");
                font-size: 12px;
                color: root.connecte ? #8a8c9b : #ffb3b0;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
                min-width: 60px;
            }

            Rectangle { horizontal-stretch: 1; }

            Titre {
                text: "AMBIANCES";
                vertical-alignment: center;
            }
            for profil in root.profils: Rectangle {
                height: 26px;
                width: etiquette.preferred-width + oubli.width + 18px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                background: profil.rappele ? #2a3352 : #1f1f28;
                border-width: 1px;
                border-color: profil.rappele ? #4d7cff : #2a2a36;
                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 4px;
                    spacing: 5px;
                    etiquette := Text {
                        text: profil.nom;
                        font-size: 11px;
                        color: profil.rappele ? #cdd8ff : #b9bbc9;
                        vertical-alignment: center;
                    }
                    oubli := Text {
                        text: "×";
                        width: 14px;
                        font-size: 13px;
                        color: #6f7180;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        TouchArea { clicked => { root.oublier-profil(profil.nom); } }
                    }
                }
                // Pose apres l'oubli, donc dessous : le « × » garde son clic.
                TouchArea {
                    width: etiquette.width + 9px;
                    x: 0;
                    clicked => { root.rappeler-profil(profil.nom); }
                }
            }
            LineEdit {
                width: 130px;
                height: 28px;
                text <=> root.nouveau-profil;
                placeholder-text: "Enregistrer sous…";
                accepted => { root.enregistrer-profil(self.text); }
            }
            Button {
                text: "Enregistrer";
                clicked => { root.enregistrer-profil(root.nouveau-profil); }
            }
        }

        HorizontalLayout {
            spacing: 12px;

            // ── Ce qu'on vise ──────────────────────────────────────────────
            Carte {
                width: 224px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 14px;

                    VerticalLayout {
                        spacing: 6px;
                        Titre { text: "CIBLE"; }
                        Text {
                            text: root.cible;
                            font-size: 14px;
                            color: #e6e6ef;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Button { text: "Tout"; clicked => { root.choisir-cible("all"); } }
                            Button { text: "Ventilateurs"; clicked => { root.choisir-cible("fans"); } }
                            Button { text: "RAM"; clicked => { root.choisir-cible("ram"); } }
                        }
                        Text {
                            text: "Clique une LED pour la viser seule. Trace un rectangle pour en prendre plusieurs, Ctrl enfoncé pour les ajouter.";
                            font-size: 11px;
                            color: #6f7180;
                            wrap: word-wrap;
                        }
                    }

                    // Les zones. Sous la cible, parce qu'une zone visée EST la
                    // cible : la couleur et les animations lui vont, et il faut
                    // le voir avant de cliquer.
                    VerticalLayout {
                        spacing: 5px;
                        Titre { text: "ZONES"; }
                        LineEdit {
                            text <=> root.nouvelle-zone;
                            placeholder-text: "Nom de la zone";
                            accepted => { root.creer-zone(self.text); }
                        }
                        Button {
                            text: "Créer la zone";
                            clicked => { root.creer-zone(root.nouvelle-zone); }
                        }
                        for couche in root.zones: HorizontalLayout {
                            spacing: 5px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 34px;
                                border-radius: 6px;
                                background: couche.visee ? #2a3352 : #14141b;
                                border-width: 1px;
                                border-color: couche.visee ? #4d7cff : #24242e;
                                VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    spacing: 0px;
                                    Text {
                                        text: couche.nom;
                                        font-size: 12px;
                                        color: #e6e6ef;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: couche.rendu + " · " + couche.combien + " LED";
                                        font-size: 10px;
                                        color: #8a8c9b;
                                        overflow: elide;
                                    }
                                }
                                TouchArea { clicked => { root.viser-zone(couche.nom); } }
                            }
                            Button {
                                text: "×";
                                clicked => { root.supprimer-zone(couche.nom); }
                            }
                        }
                        if root.zones.length == 0: Text {
                            text: "Aucune zone. Sélectionne des LED sur la maquette, donne-lui un nom, et elle prendra sa propre couleur ou sa propre animation sans toucher au reste.";
                            font-size: 11px;
                            color: #6f7180;
                            wrap: word-wrap;
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            // ── L'objet : la maquette, et sous elle les sondes ─────────────
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 12px;
                Carte {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Titre {
                                text: root.titre-maquette;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Button {
                                text: root.detail-led ? "LED" : "ventilateur";
                                clicked => { root.basculer-detail(); }
                            }
                            Button {
                                text: root.vue-face ? "de face" : "isométrique";
                                clicked => { root.basculer-vue(); }
                            }
                        }

                        // Le panneau « LE BOÎTIER » en entier. Le dessin tient
                        // dans le carre ci-dessous ; le **geste**, lui, porte
                        // sur tout le panneau (#121).
                        panneau := Rectangle {
                            vertical-stretch: 1;
                            carre := Rectangle {
                                width: min(parent.width, parent.height);
                                height: self.width;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;

                                // L'habillage, du fond vers la surface : le chassis,
                                // les parois remplies, les organes internes, les
                                // aretes du volume, puis les anneaux.
                                if root.silhouette != "": Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-width: 1;
                                    viewbox-height: 1;
                                    commands: root.silhouette;
                                    fill: #101018;
                                    stroke: #303246;
                                    stroke-width: 1.5px;
                                }
                                if root.faces != "": Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-width: 1;
                                    viewbox-height: 1;
                                    commands: root.faces;
                                    fill: #15151d;
                                }
                                if root.organes != "": Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-width: 1;
                                    viewbox-height: 1;
                                    commands: root.organes;
                                    // Rempli, sans contour : un trait en ferait
                                    // trois cadres vides flottant au milieu de la
                                    // maquette, la ou on veut trois masses sombres
                                    // qu'on ne regarde pas.
                                    fill: #1d1e2a;
                                }

                                // Les arêtes du boîtier : sans elles, la vue de
                                // trois-quarts n'est qu'un nuage de points penché.
                                if root.aretes != "": Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-width: 1;
                                    viewbox-height: 1;
                                    commands: root.aretes;
                                    stroke: #2f3040;
                                    stroke-width: 1px;
                                }

                                // L'habillage (#64) : les cadres perces des dix
                                // ventilateurs, les quatre corps de barrette, la
                                // dalle du Kraken. Rempli, pose SOUS les anneaux et
                                // sous les LED — un cadre est une piece de chassis,
                                // il passe derriere ce qui s'allume.
                                //
                                // ⚠️ `fill-rule: evenodd` fait le trou : un cadre
                                // sort en deux sous-chemins imbriques, et sans cette
                                // regle le second remplirait au lieu de percer, ce
                                // qui masquerait les huit LED qu'il entoure.
                                if root.habillage != "": Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-width: 1;
                                    viewbox-height: 1;
                                    commands: root.habillage;
                                    fill-rule: evenodd;
                                    fill: #33364a;
                                    stroke: #4b4f6b;
                                    stroke-width: 1px;
                                }

                                // Les anneaux : un ventilateur ressemble a un
                                // ventilateur, et non a huit points libres.
                                if root.anneaux != "": Path {
                                    width: parent.width;
                                    height: parent.height;
                                    viewbox-width: 1;
                                    viewbox-height: 1;
                                    commands: root.anneaux;
                                    stroke: #343650;
                                    stroke-width: 1px;
                                }

                                // Le halo, juste sous les pastilles : c'est lui qui
                                // fait qu'une LED baigne son entourage de sa couleur,
                                // comme sur les photos du boitier.
                                for couche in root.halos: Rectangle {
                                    property <length> taille: couche.rayon * 2 * parent.width;
                                    width: taille;
                                    height: taille;
                                    border-radius: taille / 2;
                                    x: couche.x * parent.width - self.width / 2;
                                    y: couche.y * parent.height - self.height / 2;
                                    background: couche.couleur;
                                }

                                // Une cible visée est plus grosse et cerclée de blanc :
                                // sur cent vingt-quatre points, une nuance de bordure ne
                                // se verrait pas, et c'est pourtant ce qui dit ce qu'on
                                // va changer.
                                for led in root.leds: Rectangle {
                                    // Le grossissement d'une cible visee est deja
                                    // dans `rayon` : un disque de ventilateur n'a
                                    // pas besoin de grandir, une pastille de LED si.
                                    property <length> taille: led.rayon * 2 * parent.width;
                                    width: taille;
                                    height: taille + led.hauteur * parent.height;
                                    border-radius: taille / 2;
                                    x: led.x * parent.width - self.width / 2;
                                    y: led.y * parent.height - self.height / 2;
                                    background: led.couleur;
                                    border-width: led.choisie ? 2px : 0px;
                                    border-color: #ffffff;
                                }

                            }

                            // Le rectangle en cours de tracé. Il ne vit que pendant
                            // le geste : ce qu'il attrape n'est décidé qu'au
                            // relâchement, par `plan.rs`.
                            //
                            // ⚠️ **Il est frere du carre, et non son enfant** (#121).
                            // Ses quatre nombres sont des fractions de PANNEAU : le
                            // rectangle couvre donc toute la surface ou le geste a
                            // lieu, marges comprises. Dessine dans le carre, un
                            // geste parti d'une marge serait rogne a son bord.
                            //
                            // ⚠️ **Le coin mobile est `mouse-x`, jamais `pressed-x`.**
                            // En Slint, `pressed-x` est la position de l'APPUI ;
                            // c'est `mouse-x` qui suit le curseur. Et `depart-x`
                            // est justement capte a l'appui, depuis `mouse-x` :
                            // les deux coins etaient donc le meme point, et le
                            // rectangle avait une largeur nulle pendant tout le
                            // geste. #76 avait deja tente de le rendre visible en
                            // montant l'opacite et en ajoutant des poignees — sans
                            // effet, forcement : aucune couleur ne rend visible un
                            // rectangle de largeur zero.
                            if root.trace: Rectangle {
                                x: min(root.trace-x0, root.trace-x1) * parent.width;
                                y: min(root.trace-y0, root.trace-y1) * parent.height;
                                width: abs(root.trace-x1 - root.trace-x0) * parent.width;
                                height: abs(root.trace-y1 - root.trace-y0) * parent.height;
                                background: #4d7cff38;
                                border-width: 2px;
                                border-color: #8fb0ff;
                                // Quatre poignees aux coins : elles disent
                                // « rectangle » la ou un cadre seul se
                                // confond avec les aretes du boitier.
                                for coin in [{ h: 0.0, v: 0.0 }, { h: 1.0, v: 0.0 },
                                             { h: 0.0, v: 1.0 }, { h: 1.0, v: 1.0 }]: Rectangle {
                                    width: 7px;
                                    height: 7px;
                                    border-radius: 3.5px;
                                    background: #ffffff;
                                    x: coin.h * parent.width - self.width / 2;
                                    y: coin.v * parent.height - self.height / 2;
                                }
                            }

                            // ⚠️ **Le `FocusScope` suit la `TouchArea` au panneau.**
                            // C'est lui qui capte `Ctrl` pour ajouter a la
                            // selection : le laisser dans le carre ferait perdre
                            // l'ajout depuis les marges, celles-la memes que #121
                            // vient de rendre cliquables.
                            clavier := FocusScope {
                                key-pressed(evenement) => {
                                    if (evenement.text == Key.Control) { root.ajout = true; }
                                    return EventResult.reject;
                                }
                                key-released(evenement) => {
                                    if (evenement.text == Key.Control) { root.ajout = false; }
                                    return EventResult.reject;
                                }

                                // Elle couvre le panneau entier, et ses fractions
                                // sont donc celles du panneau : les bords du carre
                                // tombent pres des extremites des ventilateurs, et
                                // une marge qui ne se clique pas se lit comme une
                                // maquette qui ne repond pas (#121). La conversion
                                // vers le repere du carre se fait en Rust, dans
                                // `plan::trace_dans_la_maquette`.
                                zone := TouchArea {
                                    moved => {
                                        // Le coin mobile, a chaque deplacement.
                                        // C'est la seule chose qui rende le
                                        // rectangle vivant : `pressed-x` ne bouge
                                        // pas d'un pixel pendant le geste.
                                        if (root.trace) {
                                            root.trace-x1 = self.mouse-x / self.width;
                                            root.trace-y1 = self.mouse-y / self.height;
                                        }
                                    }

                                    pointer-event(evenement) => {
                                        clavier.focus();
                                        if (evenement.kind == PointerEventKind.down) {
                                            root.trace-x0 = self.mouse-x / self.width;
                                            root.trace-y0 = self.mouse-y / self.height;
                                            root.trace-x1 = root.trace-x0;
                                            root.trace-y1 = root.trace-y0;
                                            root.trace = true;
                                        }
                                        if (evenement.kind == PointerEventKind.up) {
                                            root.trace = false;
                                            root.geste-maquette(
                                                root.trace-x0,
                                                root.trace-y0,
                                                self.mouse-x / self.width,
                                                self.mouse-y / self.height,
                                                root.ajout
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Les sondes de la machine, en bandeau sous le boîtier : elles sont
                // ce qu'on regarde le plus souvent sans rien régler, donc elles ne
                // se méritent pas au bout d'un panneau à dérouler.
                Carte {
                    height: 128px;
                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        Titre { text: "SONDES DE LA MACHINE"; }
                        Flickable {
                            vertical-stretch: 1;
                            viewport-width: bandeau.preferred-width;
                            bandeau := HorizontalLayout {
                                spacing: 8px;
                                for sonde in root.temperatures: Rectangle {
                                    // Elastique, et non 142px fixes : cinq cartes
                                    // fixes depassaient la largeur du panneau et
                                    // poussaient le second disque hors champ. Le
                                    // Flickable reste le filet, il n'est plus le
                                    // moyen normal de voir la derniere carte.
                                    // 94 px : cinq cartes tiennent dans la
                                    // colonne centrale retrecie. Le Flickable
                                    // reste le filet, pas le moyen normal de
                                    // voir la derniere.
                                    min-width: 94px;
                                    horizontal-stretch: 1;
                                    background: #14141b;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #24242e;
                                    VerticalLayout {
                                        padding: 6px;
                                        spacing: 0px;
                                        Text {
                                            text: sonde.libelle;
                                            font-size: 10px;
                                            color: #8a8c9b;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: sonde.valeur;
                                            font-size: 14px;
                                            font-weight: 700;
                                            color: sonde.lisible ? #e6a24d : #ffb3b0;
                                        }
                                        Rectangle {
                                            vertical-stretch: 1;
                                            if sonde.courbe != "": Path {
                                                width: parent.width;
                                                height: parent.height;
                                                viewbox-width: 1;
                                                viewbox-height: 1;
                                                commands: sonde.courbe;
                                                stroke: sonde.lisible ? #e6a24d : #55566a;
                                                stroke-width: 1.5px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── Ce qu'on lui fait ──────────────────────────────────────────
            // 404 px et non 350 : a 350, « Appliquer a la zone « radiateur » »
            // et « ECRAN — gauge:kraken2023elite:coolant-temp » depassaient, et
            // le `ScrollView` sortait une barre de defilement HORIZONTALE — la
            // pire des reponses, puisqu'elle cache ce qu'elle sert a atteindre.
            Carte {
                width: 404px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    // Trois onglets plutôt qu'une suite : l'écran et les
                    // ventilateurs ne se règlent pas en même temps que la
                    // couleur, et les empiler mettait les deux sous le pli.
                    HorizontalLayout {
                        spacing: 4px;
                        for nom[rang] in ["ÉCLAIRAGE", "ÉCRAN", "VENTILOS"]: Pastille {
                            horizontal-stretch: 1;
                            texte: nom;
                            retenue: root.onglet == rang;
                            choisie => { root.onglet = rang; }
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 14px;
                            padding-right: 4px;

                            // ── Onglet ÉCLAIRAGE ───────────────────────────
                            if root.onglet == 0: VerticalLayout {
                                spacing: 6px;
                                Titre { text: "COULEUR"; }
                                Rectangle {
                                    height: 48px;
                                    border-radius: 8px;
                                    background: root.apercu;
                                    border-width: 1px;
                                    border-color: #00000060;
                                }
                                LineEdit {
                                    text <=> root.couleur;
                                    placeholder-text: "ff40ff";
                                    edited => { root.couleur-saisie(self.text); }
                                    accepted => { root.appliquer-couleur(); }
                                }
                                // Trois axes qu'on comprend en les bougeant, chacun
                                // peint par ce qu'il parcourt.
                                for axe in [
                                    { nom: "Teinte", valeur: root.teinte, maximum: 359 },
                                    { nom: "Saturation", valeur: root.saturation, maximum: 100 },
                                    { nom: "Luminosité", valeur: root.luminosite, maximum: 100 },
                                ]: VerticalLayout {
                                    // ⚠️ Sans ce zéro, l'étiquette se retrouve
                                    // plus près du curseur du DESSOUS que du
                                    // sien : la VerticalLayout d'un onglet plus
                                    // court que son panneau distribue le vide
                                    // entre ses lignes, et « teinte » finissait
                                    // à 54 px de sa propre voie.
                                    vertical-stretch: 0;
                                    spacing: 1px;
                                    HorizontalLayout {
                                        Text {
                                            text: axe.nom;
                                            font-size: 12px;
                                            color: #8a8c9b;
                                            horizontal-stretch: 1;
                                        }
                                        Text {
                                            text: Math.round(axe.valeur);
                                            font-size: 12px;
                                            color: #e6e6ef;
                                        }
                                    }
                                    Curseur {
                                        valeur: axe.valeur;
                                        maximum: axe.maximum;
                                        voie: axe.nom == "Teinte"
                                            ? @linear-gradient(90deg,
                                                #ff0000 0%, #ffff00 17%, #00ff00 33%,
                                                #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%)
                                            : axe.nom == "Saturation"
                                            ? @linear-gradient(90deg, root.teinte-grise 0%, root.teinte-pure 100%)
                                            : @linear-gradient(90deg, #000000 0%, root.teinte-pure 100%);
                                        change(valeur) => {
                                            if (axe.nom == "Teinte") { root.teinte-changee(valeur); }
                                            else if (axe.nom == "Saturation") { root.saturation-changee(valeur); }
                                            else { root.luminosite-changee(valeur); }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 5px;
                                    for teinte in ["ff0000", "ff8000", "ffff00", "00ff00", "00ffff", "0000ff", "ff00ff", "ffffff"]: Rectangle {
                                        height: 22px;
                                        border-radius: 5px;
                                        background: teinte == "ff0000" ? #ff0000
                                            : teinte == "ff8000" ? #ff8000
                                            : teinte == "ffff00" ? #ffff00
                                            : teinte == "00ff00" ? #00ff00
                                            : teinte == "00ffff" ? #00ffff
                                            : teinte == "0000ff" ? #0000ff
                                            : teinte == "ff00ff" ? #ff00ff
                                            : #ffffff;
                                        TouchArea {
                                            clicked => {
                                                root.couleur = teinte;
                                                root.couleur-saisie(teinte);
                                                root.appliquer-couleur();
                                            }
                                        }
                                    }
                                }
                                // ⚠️ Texte FIXE. « Appliquer a la zone
                                // « radiateur » » elargissait le panneau : un
                                // Button n'elide pas, sa largeur preferee est
                                // celle de son texte. La cible se lit dans la
                                // colonne de gauche, sous CIBLE.
                                Button {
                                    text: "Appliquer la couleur";
                                    clicked => { root.appliquer-couleur(); }
                                }

                                Rectangle { height: 4px; }
                                Titre { text: "ANIMATION — " + root.animation-courante; }
                                // Onze pastilles plutôt qu'un menu déroulant : dix
                                // familles cachées derrière un clic, c'est ne pas
                                // savoir ce qui existe. La grille se pose à l'index
                                // — de la mise en page, pas de la géométrie du
                                // boîtier, qui reste interdite ici (#52).
                                Rectangle {
                                    property <int> colonnes: 3;
                                    property <length> pas: 30px;
                                    height: Math.ceil(root.animations.length / self.colonnes) * self.pas;
                                    for nom[rang] in root.animations: Pastille {
                                        width: (parent.width - (parent.colonnes - 1) * 4px) / parent.colonnes;
                                        x: Math.mod(rang, parent.colonnes) * (self.width + 4px);
                                        y: Math.floor(rang / parent.colonnes) * parent.pas;
                                        texte: root.animations-lisibles[rang];
                                        retenue: root.animation-choisie == rang;
                                        discrete: rang == 0;
                                        choisie => {
                                            root.animation-choisie = rang;
                                            if (rang == 0) {
                                                root.arreter-animation();
                                            } else {
                                                root.lancer-animation(nom);
                                            }
                                        }
                                    }
                                }
                                // La phrase suit le choix. Elle n'est pas de la
                                // decoration : dix noms seuls ne disent pas ce que
                                // l'animation fait.
                                Text {
                                    text: root.famille-retenue.effet;
                                    font-size: 11px;
                                    color: #6f7180;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Vitesse " + root.vitesse;
                                        font-size: 12px;
                                        color: #8a8c9b;
                                        vertical-alignment: center;
                                        width: 74px;
                                    }
                                    Slider {
                                        minimum: 1;
                                        maximum: 10;
                                        value: root.vitesse;
                                        changed(valeur) => {
                                            root.vitesse = Math.round(valeur);
                                            root.regler-animation();
                                        }
                                    }
                                }
                                // ⚠️ Le menu des directions ne s'affiche que pour
                                // les familles qui en acceptent une. `rotation`,
                                // `pouls`, `scintillement` et `thermique` la
                                // refusent, et la leur donner ferait rejeter
                                // l'`animate` ENTIER — pas seulement la clé.
                                //
                                // Invisible ne suffit pas : un élément caché garde
                                // sa place dans une VerticalLayout.
                                if root.famille-retenue.suit-une-direction: ComboBox {
                                    model: root.directions;
                                    current-index <=> root.direction;
                                    selected => { root.regler-animation(); }
                                }
                                // `thermique` exige une sonde, seule du catalogue.
                                // Elle est offerte sous son NOM LISIBLE — le slug
                                // ne remonte jamais jusqu'à l'utilisateur, ce que
                                // le cadran imposait encore et que l'issue nomme
                                // comme un défaut.
                                if root.famille-retenue.exige-une-sonde: VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Sonde suivie";
                                        font-size: 12px;
                                        color: #8a8c9b;
                                    }
                                    ComboBox {
                                        model: root.sondes-lisibles;
                                        current-index <=> root.sonde-choisie;
                                        selected => { root.regler-animation(); }
                                    }
                                }
                                // Le ressort va DANS l'onglet : sans lui, la
                                // VerticalLayout distribue le vide entre ses
                                // propres lignes, et les trois curseurs de
                                // couleur s'écartent de leur étiquette.
                                Rectangle { vertical-stretch: 1; }
                            }

                            // ── Onglet ÉCRAN ───────────────────────────────
                            if root.onglet == 1: VerticalLayout {
                                spacing: 6px;
                                Titre { text: "ÉCRAN — " + root.affichage-ecran; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Lumière " + root.luminosite-ecran;
                                        font-size: 12px;
                                        color: #8a8c9b;
                                        vertical-alignment: center;
                                        width: 74px;
                                    }
                                    Slider {
                                        minimum: 0;
                                        maximum: 100;
                                        value: root.luminosite-ecran;
                                        changed(valeur) => {
                                            root.luminosite-ecran = Math.round(valeur);
                                            root.regler-luminosite-ecran(root.luminosite-ecran);
                                        }
                                    }
                                }
                                Rectangle {
                                    property <int> colonnes: 3;
                                    property <length> pas: 30px;
                                    height: Math.ceil(root.affichages.length / self.colonnes) * self.pas;
                                    for nom[rang] in root.affichages: Pastille {
                                        width: (parent.width - (parent.colonnes - 1) * 4px) / parent.colonnes;
                                        x: Math.mod(rang, parent.colonnes) * (self.width + 4px);
                                        y: Math.floor(rang / parent.colonnes) * parent.pas;
                                        texte: root.affichages-lisibles[rang];
                                        retenue: root.affichage-choisi == rang;
                                        discrete: rang == 0;
                                        // Choisir, c'est composer : la poignee se
                                        // leve, et le releve d'une seconde cesse
                                        // d'ecraser ce qu'on decide (#48).
                                        choisie => {
                                            root.affichage-choisi = rang;
                                            root.saisir-ecran();
                                        }
                                    }
                                }

                                // « cadran » : la sonde, sous son nom lisible.
                                if root.affichage-choisi == 1: ComboBox {
                                    model: root.sondes-lisibles;
                                    current-index <=> root.sonde-choisie;
                                    selected => { root.saisir-ecran(); }
                                }
                                // « image » et « gif » : un CHAMP DE TEXTE, pas un
                                // selecteur de fichiers — une boite de dialogue
                                // demanderait le portail XDG, donc un client D-Bus,
                                // donc une dependance de runtime que l'ADR-001
                                // refuse. Le chemin se colle depuis le gestionnaire.
                                if root.affichage-choisi == 2 || root.affichage-choisi == 3: LineEdit {
                                    placeholder-text: "/chemin/absolu/vers/l'image";
                                    text <=> root.argument-ecran;
                                    edited => { root.saisir-ecran(); }
                                }
                                if root.affichage-choisi != 4: Button {
                                    text: "Appliquer à l'écran";
                                    clicked => {
                                        root.poser-ecran(root.affichages[root.affichage-choisi], root.argument-ecran);
                                    }
                                }

                                // ── La composition (#80) ───────────────────
                                if root.affichage-choisi == 4: VerticalLayout {
                                    spacing: 8px;

                                    // ⚠️ LA DALLE EST RONDE — observé le
                                    // 2026-08-08. 21 % du tampon carré ne
                                    // s'affiche nulle part, et rien ne le
                                    // signale : le contrôleur accepte l'image
                                    // entière. Composer sur un carré serait
                                    // juger la mise en page sur une surface qui
                                    // n'existe pas, d'où ce disque.
                                    Rectangle {
                                        height: 176px;
                                        disque := Rectangle {
                                            width: min(parent.width, parent.height);
                                            height: self.width;
                                            x: (parent.width - self.width) / 2;
                                            border-radius: root.rayon-disque * self.width;
                                            background: #0a0a0e;
                                            border-width: 1px;
                                            border-color: #33364a;

                                            for ancre in root.ancres: Rectangle {
                                                x: ancre.x * parent.width;
                                                y: ancre.y * parent.height;
                                                width: ancre.largeur * parent.width;
                                                height: ancre.hauteur * parent.height;
                                                border-radius: 3px;
                                                background: ancre.occupee ? #2a3352 : #16161e;
                                                border-width: ancre.choisie ? 2px : 1px;
                                                border-color: ancre.choisie ? #4d7cff
                                                    : (ancre.occupee ? #3d4569 : #26262f);
                                                Text {
                                                    text: ancre.occupee ? ancre.porte : ancre.nom;
                                                    font-size: 9px;
                                                    color: ancre.occupee ? #cdd8ff : #55566a;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    width: parent.width - 4px;
                                                    x: 2px;
                                                    overflow: elide;
                                                }
                                                TouchArea { clicked => { root.viser-ancre(ancre.nom); } }
                                            }
                                        }
                                    }

                                    Text {
                                        text: root.champs-poses + " champ" + (root.champs-poses > 1 ? "s" : "")
                                            + " sur " + root.champs-max + ". Clique une ancre du disque pour la garnir.";
                                        font-size: 11px;
                                        color: #6f7180;
                                        wrap: word-wrap;
                                    }

                                    Titre { text: "FOND"; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        for nom[rang] in ["Noir", "Image"]: Pastille {
                                            horizontal-stretch: 1;
                                            texte: nom;
                                            retenue: root.fond-choisi == rang;
                                            choisie => { root.fond-choisi = rang; root.saisir-ecran(); }
                                        }
                                    }
                                    if root.fond-choisi == 1: LineEdit {
                                        placeholder-text: "/chemin/absolu/vers/le/fond";
                                        text <=> root.chemin-fond;
                                        edited => { root.saisir-ecran(); }
                                    }
                                    Button {
                                        text: "Poser le fond";
                                        clicked => { root.poser-fond(); }
                                    }

                                    Rectangle { height: 2px; }
                                    Titre { text: "CHAMP DE L'ANCRE « " + root.ancre-visee + " »"; }
                                    HorizontalLayout {
                                        spacing: 4px;
                                        for nom[rang] in ["Température", "Texte"]: Pastille {
                                            horizontal-stretch: 1;
                                            texte: nom;
                                            retenue: root.source-choisie == rang;
                                            choisie => { root.source-choisie = rang; root.saisir-ecran(); }
                                        }
                                    }
                                    if root.source-choisie == 0: ComboBox {
                                        model: root.sondes-lisibles;
                                        current-index <=> root.sonde-choisie;
                                        selected => { root.saisir-ecran(); }
                                    }
                                    // Le libellé n'est pas un ornement :
                                    // `kraken2023elite:coolant-temp` fait
                                    // vingt-huit caractères sur six centimètres
                                    // de dalle. Ici on nomme soi-même ce qu'on
                                    // regarde.
                                    LineEdit {
                                        placeholder-text: root.source-choisie == 0
                                            ? "Libellé affiché — « LIQUIDE »"
                                            : "Le texte à afficher";
                                        text <=> root.libelle-champ;
                                        edited => { root.saisir-ecran(); }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button {
                                            horizontal-stretch: 1;
                                            text: "Poser";
                                            clicked => { root.poser-champ(root.libelle-champ); }
                                        }
                                        Button {
                                            text: "Vider";
                                            clicked => { root.vider-champ(root.libelle-champ); }
                                        }
                                    }
                                    Button {
                                        text: "Revenir à l'affichage simple";
                                        clicked => { root.arreter-composition(); }
                                    }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }

                            // ── Onglet VENTILATEURS ────────────────────────
                            if root.onglet == 2: VerticalLayout {
                                spacing: 8px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Titre {
                                        text: "VENTILATEURS";
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    // ⚠️ UN point d'interrogation pour le
                                    // panneau, et non un par ligne. Le panneau
                                    // qu'il ouvre liste les SIX modes quelle que
                                    // soit la ligne d'ou l'on part : cinq icones
                                    // ouvriraient cinq fois le meme texte, dans
                                    // la rangee meme ou le cadenas vient de
                                    // prendre de la place.
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: #1f1f28;
                                        border-width: 1px;
                                        border-color: #2a2a36;
                                        Text {
                                            text: "?";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #b9bbc9;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        TouchArea { clicked => { modes.show(); } }
                                    }
                                }
                                modes := PopupWindow {
                                    close-policy: close-on-click-outside;
                                    width: 320px;
                                    height: 460px;
                                    Rectangle {
                                        background: #14141b;
                                        border-radius: 10px;
                                        border-width: 1px;
                                        border-color: #2a2a36;
                                        VerticalLayout {
                                            padding: 12px;
                                            spacing: 8px;
                                            Titre { text: "CE QUE LA COLONNE MODE VEUT DIRE"; }
                                            for aide in root.aides-des-modes: VerticalLayout {
                                                spacing: 2px;
                                                Text {
                                                    text: aide.mode;
                                                    font-size: 12px;
                                                    font-weight: 700;
                                                    color: #e6e6ef;
                                                }
                                                Text {
                                                    text: aide.texte;
                                                    font-size: 11px;
                                                    color: #8a8c9b;
                                                    wrap: word-wrap;
                                                }
                                            }
                                            Rectangle { vertical-stretch: 1; }
                                        }
                                    }
                                }
                                for canal in root.ventilateurs: VerticalLayout {
                                    spacing: 2px;
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text {
                                            text: canal.position == "" ? canal.canal : canal.position;
                                            font-size: 12px;
                                            // Le nom pâlit avec sa ligne. Un canal en
                                            // quarantaine garde sa place et doit se
                                            // voir comme tel : le faire disparaître
                                            // laissait croire qu'il n'existe pas —
                                            // donc qu'il n'y a rien à régler, ni rien
                                            // à réparer (#100).
                                            color: canal.lisible ? #e6e6ef : #8a8c9b;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        // ⚠️ LE temoin qui distingue les deux
                                        // barres grisees. Un canal regule et un
                                        // canal verrouille sont inertes pour
                                        // des raisons opposees, et sans un
                                        // signe qui ne parait que sur l'un des
                                        // deux, « pourquoi je ne peux pas
                                        // bouger cette barre » n'a pas de
                                        // reponse.
                                        //
                                        // Il emprunte le bleu de tout ce que la
                                        // fenetre montre comme RETENU — onglet
                                        // actif, zone visee, ambiance rappelee.
                                        // Un canal regule est exactement cela :
                                        // tenu par le demon.
                                        //
                                        // ⚠️ `width: 0px` en plus de `visible` :
                                        // un element invisible garde sa place en
                                        // layout, et le laisser la creuserait un
                                        // trou sur les onze canaux qui ne sont
                                        // pas regules.
                                        Rectangle {
                                            visible: canal.sous-regulation;
                                            width: canal.sous-regulation ? 54px : 0px;
                                            height: 15px;
                                            border-radius: 7px;
                                            background: #2a3352;
                                            border-width: 1px;
                                            border-color: #4d7cff;
                                            Text {
                                                text: "régulé";
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: #cdd8ff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: canal.lisible ? canal.rpm + " tr/min · " + canal.mode : "illisible";
                                            font-size: 11px;
                                            color: canal.lisible ? #8a8c9b : #ffb3b0;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Slider {
                                            minimum: 0;
                                            maximum: 100;
                                            // La valeur vient de la poignée du
                                            // canal, pas de la mesure brute : c'est
                                            // elle qui décide si une mesure a le
                                            // droit de déplacer le curseur.
                                            value: canal.pwm;
                                            // ⚠️ La poignée d'un canal muet ne se
                                            // tire pas (#100). Le curseur reste où
                                            // il était plutôt que de retomber à
                                            // zéro, qui se lirait comme un
                                            // ventilateur qu'on vient d'arrêter.
                                            //
                                            // ⚠️ Ni celle d'un canal qui régule
                                            // seul, tant que son cadenas est
                                            // fermé (#112) : la tirer
                                            // remplacerait une régulation
                                            // qu'aucune commande ne rétablit.
                                            // Les deux règles se composent, et
                                            // c'est `commande_verrouillable`
                                            // qui en décide vraiment — ceci
                                            // n'est que ce qui se voit.
                                            // ⚠️ Ni celle d'un canal que le
                                            // demon regule (#113), et celle-la
                                            // ne s'ouvre par aucun cadenas : le
                                            // verrou est une confirmation, la
                                            // regulation une prise en charge, et
                                            // seul « Ne plus reguler » la rend.
                                            // C'est `commande_effective` qui en
                                            // decide vraiment — ceci n'est que
                                            // ce qui se voit.
                                            enabled: canal.lisible
                                                && !canal.sous-regulation
                                                && (!canal.regule-seul || canal.deverrouille);
                                            changed(valeur) => {
                                                root.regler-ventilateur(canal.canal, Math.round(valeur));
                                            }
                                            released(valeur) => {
                                                root.relacher-ventilateur(canal.canal);
                                            }
                                        }
                                        // La consigne chiffree, contre la barre
                                        // qui la porte. Elle se distingue du
                                        // regime de trois facons plutot qu'une :
                                        // son unite (« % » contre « tr/min »),
                                        // sa ligne, et sa couleur — le regime est
                                        // gris et petit, la consigne claire et de
                                        // la taille du libelle de position.
                                        //
                                        // ⚠️ `min-width` : sans elle, le curseur
                                        // se raccourcirait d'un pixel a chaque
                                        // fois que le nombre change de largeur
                                        // — sous le doigt qui le tire.
                                        Text {
                                            text: canal.consigne;
                                            font-size: 12px;
                                            color: canal.lisible ? #e6e6ef : #ffb3b0;
                                            vertical-alignment: center;
                                            horizontal-alignment: right;
                                            min-width: 40px;
                                        }
                                        // Le cadenas. ⚠️ Il ne parait QUE sur un
                                        // canal qui regule seul : sept
                                        // ventilateurs sur dix sont en
                                        // « manuel », et leur imposer un geste
                                        // de plus serait payer le prix du
                                        // verrou sans en tirer la protection.
                                        //
                                        // ⚠️ Le libelle dit ce que le CLIC FAIT,
                                        // et non l'etat courant. C'est ce qui
                                        // rend le geste explicite — critere
                                        // d'acceptation de #112.
                                        //
                                        // Un glyphe tiendrait : U+1F512 sort bien
                                        // de la police de repli du rendu logiciel,
                                        // mesure le 2026-08-15 — U+26BF, lui, sort
                                        // en carre vide. Mais un cadenas seul ne
                                        // dit pas dans quel sens il bascule :
                                        // montre-t-il l'etat, ou l'action ? C'est
                                        // l'arbitrage des dix pastilles
                                        // d'animation contre un menu deroulant, et
                                        // ce projet ecrit les mots. Le prix est en
                                        // largeur, et il tombe sur les seuls
                                        // canaux qu'on ne regle presque jamais —
                                        // ceux qui regulent tout seuls.
                                        //
                                        // ⚠️ `width: 0px` en plus de `visible` :
                                        // un element invisible garde sa place
                                        // en layout, et le laisser la
                                        // creuserait un trou.
                                        Button {
                                            text: canal.deverrouille ? "Verrouiller" : "Déverrouiller";
                                            visible: canal.regule-seul;
                                            width: canal.regule-seul ? self.preferred-width : 0px;
                                            // Inerte sur un canal muet, comme
                                            // « auto » (#100) : deverrouiller
                                            // une barre qui n'atteint personne
                                            // ne fait qu'annuler la protection.
                                            enabled: canal.lisible;
                                            clicked => { root.basculer-verrou(canal.canal); }
                                        }
                                        // ⚠️ `width: 0px` en plus de `visible` : un
                                        // element invisible garde sa place en
                                        // layout, et le laisser la creuserait un
                                        // trou a droite des trois curseurs de
                                        // nzxtsmart2.
                                        Button {
                                            text: "auto";
                                            visible: canal.sait-faire-auto;
                                            width: canal.sait-faire-auto ? self.preferred-width : 0px;
                                            // Montré mais inerte tant que le canal
                                            // se tait : c'est le bouton qu'on irait
                                            // chercher quand la ligne ne montre plus
                                            // rien, et il n'atteindrait personne.
                                            enabled: canal.lisible;
                                            clicked => { root.rendre-au-firmware(canal.canal); }
                                        }
                                        // La regulation cote hote (#113). ⚠️ Elle
                                        // ne parait QUE sur un canal dont le
                                        // pilote n'a aucun mode automatique :
                                        // les deux canaux du Kraken regulent
                                        // deja par leur firmware, et #99 les met
                                        // hors scope — leur proposer une boucle
                                        // hote serait echanger une garantie qui
                                        // tient sans demon contre une qui n'en
                                        // tient pas.
                                        //
                                        // ⚠️ Le libelle dit ce que le CLIC FAIT,
                                        // comme le cadenas : c'est aussi ce qui
                                        // le distingue de lui a la lecture —
                                        // « Ne plus reguler » et
                                        // « Deverrouiller » ne se confondent
                                        // pas, la ou deux barres grisees, si.
                                        //
                                        // ⚠️ Sur SHYNAEL les deux ne coexistent
                                        // jamais sur une meme ligne : les trois
                                        // canaux regulables lisent « manuel »,
                                        // donc sans cadenas. La rangee garde sa
                                        // poignee pleine largeur.
                                        Button {
                                            text: canal.sous-regulation ? "Ne plus réguler" : "Réguler";
                                            visible: canal.regulable;
                                            width: canal.regulable ? self.preferred-width : 0px;
                                            // Inerte sur un canal muet (#100) :
                                            // ni le prendre ni le rendre n'a de
                                            // sens tant qu'on ne sait pas ce
                                            // qu'il fait.
                                            enabled: canal.lisible;
                                            clicked => { root.basculer-regulation(canal.canal); }
                                        }
                                    }
                                }

                                // ── La courbe de la regulation ─────────────
                                //
                                // Un seul reglage pour les trois canaux : tant
                                // que la repartition physique des ventilateurs
                                // par canal reste l'inconnue de
                                // `docs/VENTILATEURS.md`, une courbe par canal
                                // n'aurait rien de plus a dire (#99, #113).
                                Titre { text: "COURBE DE RÉGULATION"; }
                                Text {
                                    text: "La température du liquide décide de la consigne des canaux régulés. "
                                        + "Hors des paliers, elle est ramenée aux bornes — jamais prolongée.";
                                    font-size: 11px;
                                    color: #8a8c9b;
                                    wrap: word-wrap;
                                }
                                // Le trace de ce que les paliers donnent. Il
                                // vient de `Courbe::consigne`, celle que le
                                // demon execute : ce qu'on voit ici est ce que
                                // le boitier appliquera.
                                Rectangle {
                                    // ⚠️ **La hauteur suit la largeur**, par le
                                    // meme rapport que le viewbox du trace. Une
                                    // hauteur fixe rendrait le cadre et le
                                    // trace de rapports differents, et la mise a
                                    // l'echelle uniforme de Slint recollerait la
                                    // courbe dans un carre centre — le defaut
                                    // que `TRACE_ASPECT` corrige.
                                    height: (parent.width - 16px) / root.trace-aspect + 16px;
                                    background: #14141b;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #24242e;
                                    if root.trace-courbe != "": Path {
                                        x: 8px;
                                        y: 8px;
                                        width: parent.width - 16px;
                                        height: parent.height - 16px;
                                        viewbox-width: root.trace-aspect;
                                        viewbox-height: 1;
                                        commands: root.trace-courbe;
                                        stroke: #4d7cff;
                                        stroke-width: 2px;
                                    }
                                    // Une courbe qui n'en est pas une ne se
                                    // dessine pas : un trace plausible sous un
                                    // refus serait le pire des deux.
                                    if root.trace-courbe == "": Text {
                                        text: "—";
                                        color: #55566a;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                HorizontalLayout {
                                    Text {
                                        text: root.borne-froide;
                                        font-size: 10px;
                                        color: #6f7180;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: root.borne-chaude;
                                        font-size: 10px;
                                        color: #6f7180;
                                        horizontal-alignment: right;
                                    }
                                }
                                for palier[rang] in root.paliers: HorizontalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: palier.temperature;
                                        font-size: 11px;
                                        color: #b9bbc9;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        min-width: 52px;
                                    }
                                    Slider {
                                        // ⚠️ Des degres entiers, et non des
                                        // millidegres : la poignee gradue, elle
                                        // ne mesure pas. Le millidegre reste
                                        // l'unite du protocole, et un palier au
                                        // demi-degre rendu par le socket reste
                                        // intact tant qu'on ne touche pas a sa
                                        // poignee.
                                        minimum: 20;
                                        maximum: 70;
                                        value: palier.degres;
                                        changed(valeur) => {
                                            root.regler-palier-temperature(rang, Math.round(valeur));
                                        }
                                    }
                                    Text {
                                        text: palier.consigne;
                                        font-size: 11px;
                                        color: #b9bbc9;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        min-width: 34px;
                                    }
                                    Slider {
                                        minimum: 0;
                                        maximum: 100;
                                        value: palier.pourcent;
                                        changed(valeur) => {
                                            root.regler-palier-consigne(rang, Math.round(valeur));
                                        }
                                    }
                                }
                                // ⚠️ Le refus est ecrit ICI, devant les
                                // poignees, et non dans le bandeau de tete : une
                                // courbe invalide est refusee EN LE DISANT et
                                // sans etre posee (#113), et le dire ailleurs
                                // qu'a l'endroit du geste reviendrait a
                                // l'apprendre apres coup.
                                if root.refus-courbe != "": Text {
                                    text: root.refus-courbe;
                                    font-size: 11px;
                                    color: #ffb3b0;
                                    wrap: word-wrap;
                                }
                                Button {
                                    text: "Appliquer la courbe";
                                    enabled: root.paliers.length > 0;
                                    clicked => { root.appliquer-courbe(); }
                                }
                                Rectangle { vertical-stretch: 1; }
                            }
                        }
                    }
                }
            }
        }
    }
}
