# Règles udev de Reverb — accès sans root aux périphériques pilotés.
#
# Installation :
#   sudo cp packaging/60-reverb.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger
#
# `TAG+="uaccess"` confie l'accès à systemd-logind, qui pose une ACL sur le nœud
# pour l'utilisateur physiquement connecté, et la retire à la déconnexion.
# Ni `MODE=`, ni `GROUP=` : le premier ouvre le périphérique à tout process
# local, le second à tous les membres d'un groupe, connectés ou non.
#
# `TAG+="reverb"` n'accorde rien — un tag udev est une étiquette, pas une
# permission. Il signe la règle, et c'est le seul moyen de vérifier qu'elle a
# déclenché : `udevadm test` ne journalise pas les `TAG+=`, seulement les règles
# à effet de bord. Sans cette signature, impossible de dire si l'`uaccess` posé
# sur un périphérique vient d'ici, d'OpenRGB, ou d'ailleurs :
#
#   udevadm info -q all -n /dev/hidraw12 | grep TAGS
#
# Pour le Kraken, interroger le nœud /dev/bus/usb/… : la règle porte sur le
# périphérique USB, pas sur un nœud hidraw.
#
# Une règle par ligne, sans structure de garde (`GOTO` / `LABEL`) : à quatre
# règles, le saut coûte plus en lisibilité qu'il ne fait gagner à udev.

# Contrôleurs d'éclairage — commandes HID sur /dev/hidraw*.
# `SUBSYSTEMS` au pluriel : le tag doit atteindre le nœud hidraw comme le nœud
# USB parent, les attributs idVendor/idProduct ne vivant que sur le second.
SUBSYSTEMS=="usb|hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2019", TAG+="uaccess", TAG+="reverb"
SUBSYSTEMS=="usb|hidraw", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="2012", TAG+="uaccess", TAG+="reverb"

# Kraken Elite 2023 — l'écran ne passe pas par hidraw. Les commandes de contrôle
# empruntent l'endpoint interrupt 0x01 et l'image l'endpoint bulk 0x02
# (docs/SPEC-KRAKEN-LCD.md §1) : c'est le nœud /dev/bus/usb/… qu'il faut ouvrir,
# d'où `SUBSYSTEM` au singulier.
SUBSYSTEM=="usb", ATTRS{idVendor}=="1e71", ATTRS{idProduct}=="300c", TAG+="uaccess", TAG+="reverb"

# RAM Corsair — l'éclairage passe par SMBus, pas par USB : il n'y a ni idVendor
# ni idProduct à filtrer, seulement un adaptateur i2c à nommer
# (docs/SPEC-CORSAIR-RAM.md §3).
#
# ⚠️ Un seul adaptateur, nommé. OpenRGB ouvre `KERNEL=="i2c-[0-99]*"`, c'est-à-dire
# TOUS les bus de la machine — ceux du GPU compris. On ne reproduit pas : ce bus
# porte les hubs SPD des barrettes en 0x50–0x53, et un accès de trop y corrompt
# un DIMM.
#
# Le nom est celui du bus où le noyau a lié `spd5118` aux quatre hubs SPD
# (8-0050…8-0053) : c'est donc bien celui des barrettes, établi sans un octet
# émis. `i2c-piix4` en enregistre deux autres, dont un homonyme « port 2 at 0b00 »
# que la seule base d'E/S ne distingue pas.
SUBSYSTEM=="i2c-dev", ATTR{name}=="SMBus PIIX4 adapter port 0 at 0b00", TAG+="uaccess", TAG+="reverb"
